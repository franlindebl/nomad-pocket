{
  "name": "nomad-pocket-alerts",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Nomad Pocket official alerts push server (Cloud Functions for Firebase); docs/ALERTS_PLAN.md, phase 2",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --external:firebase-functions --external:firebase-admin --sourcemap --log-level=warning",
    "typecheck": "tsc -p .",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "typescript": "~5.9"
  }
}
