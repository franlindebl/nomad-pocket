<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets the phone's Play services deliver FCM messages to this app (the permission Firebase's own manifest asks
       for). Only the permission: no Google code comes with it. -->
  <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />

  <application>
    <!-- Only Play services (holder of c2dm SEND, a signature permission) can send to it. -->
    <receiver
      android:name="expo.modules.nomadpush.PushReceiver"
      android:exported="true"
      android:permission="com.google.android.c2dm.permission.SEND">
      <intent-filter>
        <action android:name="com.google.android.c2dm.intent.RECEIVE" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
