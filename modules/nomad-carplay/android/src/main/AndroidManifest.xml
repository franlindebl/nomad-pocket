<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android Auto, navigation category: the car's templates and our own map on its surface. -->
  <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
  <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

  <application>
    <!-- Only a name the Android Auto host reads; no Google Play services library behind it. -->
    <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
    <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
    <service android:name="expo.modules.nomadcarplay.NomadCarAppService" android:exported="true">
      <intent-filter>
        <action android:name="androidx.car.app.CarAppService" />
        <category android:name="androidx.car.app.category.NAVIGATION" />
      </intent-filter>
      <!-- Destinations from the car's assistant or other apps (geo: URIs): NomadCarSession.navigate. -->
      <intent-filter>
        <action android:name="androidx.car.app.action.NAVIGATE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="geo" />
      </intent-filter>
    </service>
  </application>
</manifest>
