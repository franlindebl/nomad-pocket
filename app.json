{
  "expo": {
    "name": "Nomad Pocket",
    "slug": "nomad-pocket",
    "version": "2.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "nomadpocket",
    "userInterfaceStyle": "dark",
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.fjlinde.nomadpocket",
      "buildNumber": "42",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": [
          "es",
          "en"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Nomad Pocket no accede a tus fotos. Algunas librerías incluidas pueden leer imágenes de la fototeca, pero la app nunca lo solicita.",
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.fjlinde.nomadpocket",
      "versionCode": 27,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0C0C",
          "image": "./assets/images/splash-icon-dark.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/ChakraPetch-Medium.ttf",
              "./assets/fonts/ChakraPetch-SemiBold.ttf",
              "./assets/fonts/ChakraPetch-Bold.ttf",
              "./assets/fonts/IBMPlexSans-Regular.ttf",
              "./assets/fonts/IBMPlexSans-Medium.ttf",
              "./assets/fonts/IBMPlexSans-SemiBold.ttf",
              "./assets/fonts/IBMPlexSans-Bold.ttf",
              "./assets/fonts/IBMPlexMono-Regular.ttf",
              "./assets/fonts/IBMPlexMono-Medium.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Chakra Petch",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/ChakraPetch-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/ChakraPetch-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/ChakraPetch-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "IBM Plex Sans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/IBMPlexSans-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/IBMPlexSans-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/IBMPlexSans-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/IBMPlexSans-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "IBM Plex Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/IBMPlexMono-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/IBMPlexMono-Medium.ttf",
                    "weight": 500
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nomad Pocket usa tu ubicación para mostrarte en los mapas sin conexión, medir distancias y guiarte hasta lugares y puntos de emergencia, también con la pantalla bloqueada mientras navegas.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/images/notification-icon.png",
          "color": "#F2643A"
        }
      ],
      "./plugins/with-android-backup-rules",
      "./plugins/with-android-no-firebase",
      "./plugins/with-android-no-install-referrer",
      "./plugins/with-android-webview-privacy",
      [
        "./plugins/with-carplay",
        {
          "enabled": true,
          "entitlement": true
        }
      ],
      "./plugins/with-store-build",
      "./plugins/with-e2e-local-network",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nomad Pocket usa el micrófono solo cuando tocas el botón de dictar en el asistente, para escribir tu pregunta con la voz. El audio se procesa en tu dispositivo y no se guarda ni se envía.",
          "speechRecognitionPermission": "Nomad Pocket convierte tu voz en texto en tu dispositivo, sin conexión, cuando dictas una pregunta al asistente."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
