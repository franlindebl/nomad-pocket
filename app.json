{
  "expo": {
    "name": "Nomad Pocket",
    "slug": "nomad-pocket",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "nomadpocket",
    "userInterfaceStyle": "automatic",
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.fjlinde.nomadpocket",
      "buildNumber": "23",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": [
          "es",
          "en"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Nomad Pocket no accede a tus fotos. Algunas librerías incluidas pueden leer imágenes de la fototeca, pero la app nunca lo solicita."
      }
    },
    "android": {
      "package": "com.fjlinde.nomadpocket",
      "versionCode": 23,
      "adaptiveIcon": {
        "backgroundColor": "#18171B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0D0D0F",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Inter_400Regular.ttf",
              "./assets/fonts/Inter_500Medium.ttf",
              "./assets/fonts/Inter_600SemiBold.ttf",
              "./assets/fonts/Inter_700Bold.ttf",
              "./assets/fonts/Inter_800ExtraBold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Inter_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Inter_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Inter_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nomad Pocket usa tu ubicación para mostrarte en los mapas sin conexión, medir distancias y guiarte hasta lugares y puntos de emergencia.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/images/notification-icon.png",
          "color": "#F2643A"
        }
      ],
      "./plugins/with-android-backup-rules",
      "./plugins/with-android-no-firebase",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nomad Pocket usa el micrófono solo cuando tocas el botón de dictar en el asistente, para escribir tu pregunta con la voz. El audio se procesa en tu dispositivo y no se guarda ni se envía.",
          "speechRecognitionPermission": "Nomad Pocket convierte tu voz en texto en tu dispositivo, sin conexión, cuando dictas una pregunta al asistente."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
